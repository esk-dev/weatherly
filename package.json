{
  "name": "weather-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch --browsers=ChromeHeadless",
    "lint:all": "ng lint --quiet",
    "lint:fix": "eslint -c eslint.config.js --fix $(git diff --name-only --diff-filter=d HEAD | grep  -E \"(.js$|.ts$|.html$)\")",
    "lint:affected": "eslint -c eslint.config.js $(git diff --name-only --diff-filter=d HEAD | grep  -E \"(.js$|.ts$|.html$)\")",
    "format-fix": "npx prettier --write **/* --ignore-unknown",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.0",
    "@angular/cdk": "^19.2.7",
    "@angular/common": "^19.1.0",
    "@angular/compiler": "^19.1.0",
    "@angular/core": "^19.1.0",
    "@angular/forms": "^19.1.0",
    "@angular/material": "^19.2.7",
    "@angular/platform-browser": "^19.1.0",
    "@angular/platform-browser-dynamic": "^19.1.0",
    "@angular/router": "^19.1.0",
    "@angular/service-worker": "^19.1.0",
    "@ngrx/signals": "^19.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.8",
    "@angular/cli": "^19.1.8",
    "@angular/compiler-cli": "^19.1.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "19.3.0",
    "commitlint": "^19.8.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-perfectionist": "^3.8.0",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.27.0"
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  }
}
